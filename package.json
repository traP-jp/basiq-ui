{
  "name": "basiq-ui",
  "version": "0.0.0",
  "private": true,
  "description": "A traQ-inspired Vue component library.",
  "keywords": [
    "component-library",
    "design-system",
    "traq",
    "vue"
  ],
  "homepage": "https://github.com/traP-jp/basiq-ui#readme",
  "bugs": {
    "url": "https://github.com/traP-jp/basiq-ui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traP-jp/basiq-ui.git"
  },
  "style": "./dist/styles.css",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "format": "oxfmt --config oxfmt.config.ts",
    "format:check": "oxfmt --check --config oxfmt.config.ts",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint && pnpm run lint:stylelint",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm run lint:fix:oxlint && pnpm run lint:fix:eslint && pnpm run lint:fix:stylelint",
    "lint:fix:eslint": "eslint . --fix",
    "lint:fix:oxlint": "oxlint --fix .",
    "lint:fix:stylelint": "stylelint \"src/**/*.{css,vue}\" \".storybook/**/*.css\" --fix",
    "lint:oxlint": "oxlint --deny-warnings .",
    "lint:stylelint": "stylelint \"src/**/*.{css,vue}\" \".storybook/**/*.css\"",
    "playwright:install": "playwright install chromium",
    "playwright:install:ci": "playwright install --with-deps chromium",
    "prepack": "pnpm run build",
    "release:prepare": "node scripts/prepare-release.mjs",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "test": "pnpm run test:release && vitest run",
    "test:release": "node --test scripts/release-version.test.mjs scripts/prepare-release.test.mjs scripts/create-publish-plan.test.mjs",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "reka-ui": "2.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/m-plus-1p": "5.3.0",
    "@storybook/addon-a11y": "10.5.6",
    "@storybook/addon-vitest": "10.5.6",
    "@storybook/vue3-vite": "10.5.6",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/browser-playwright": "4.1.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.77.0",
    "eslint-plugin-storybook": "10.5.6",
    "eslint-plugin-vue": "10.10.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "playwright": "1.62.1",
    "postcss-html": "2.0.0",
    "storybook": "10.5.6",
    "stylelint": "17.14.1",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "2.0.0",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue": "3.5.41",
    "vue-tsc": "3.3.9"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "packageManager": "pnpm@11.20.0"
}
